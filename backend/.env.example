# Banco de dados SQLite
DATABASE_URL="file:./dev.db"

# JWT — gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="troque-por-string-aleatoria-longa"
JWT_REFRESH_SECRET="troque-por-outra-string-aleatoria-longa"

# Admin inicial (usado apenas no seed)
ADMIN_EMAIL="admin@offroad.com"
ADMIN_PASSWORD="troque-por-senha-forte"

# Mercado Pago
MP_ACCESS_TOKEN="TEST-xxxx"          # sandbox: começa com TEST-, produção com APP_USR-
MP_WEBHOOK_SECRET="sua-chave-secreta-do-webhook-mp"

# URL do frontend (para CORS e redirects do MP)
FRONTEND_URL="http://localhost:5173"

# URL pública do backend (para notification_url do webhook do MP)
BACKEND_URL="http://localhost:3001"

# Porta do backend
PORT=3001
